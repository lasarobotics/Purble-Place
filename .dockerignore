# Keep the build context small and make sure no local secret is ever baked
# into an image layer.
.git/
.github/
.claude/

backend/.venv/
backend/data/
backend/.env
**/__pycache__/
*.pyc

frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/tsconfig.tsbuildinfo

# Never copy a service-account key into the image — it is passed at runtime
# as the FIREBASE_SERVICE_ACCOUNT environment variable.
*service-account*.json
*serviceAccountKey*.json
.firebase/

# Legacy standalone prototype, not part of the deployed app.
server/
src/
index.html
package.json
package-lock.json

*.log
*.md
!README.md
