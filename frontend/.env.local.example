# Base URL of the HazeHub backend API.
#
# Leave this EMPTY for a Firebase Hosting deployment: Hosting rewrites /api/**
# and /ws to the Cloud Run service, so the frontend and backend share one
# origin (no CORS, no backend URL baked into the bundle).
#
# For local development, point it at the backend you are running.
NEXT_PUBLIC_API_URL=http://localhost:8000
