# MegaScout deployment config. Copy to `.env` in this folder and edit.
# docker compose --env-file .env up -d --build

# --- Postgres (internal to the compose network) ---
POSTGRES_USER=haze
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=hazehub

# --- App auth / identity ---
HAZEHUB_TEAM_PASSWORD=HazeRain!
HAZEHUB_ADMIN_ID=admin
HAZEHUB_SECRET=change-me-in-production
HAZEHUB_SEASON=2026
TBA_AUTH_KEY=

# --- Azure synchronization ---
# Leave CLOUD_SYNC_URL blank to run local-only: submissions still commit and
# queue durably in the outbox; nothing is lost, nothing is shipped until you
# set this to the Azure ingest endpoint. CLOUD_SYNC_KEY is sent as a bearer.
CLOUD_SYNC_URL=
CLOUD_SYNC_KEY=
HAZEHUB_SYNC_INTERVAL=5

# --- System Health network panel (optional) ---
# UniFi/gateway stats API returning {carrier, signal_quality, packet_loss}.
HAZEHUB_GATEWAY_STATS_URL=

# --- Backups ---
BACKUP_INTERVAL_SECONDS=3600
BACKUP_KEEP=48
