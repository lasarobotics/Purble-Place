{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hazehub-domain-staging",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "hazehub-staging", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../migrations" }],
  "durable_objects": { "bindings": [{ "name": "MEETINGS", "class_name": "MeetingRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MeetingRoom"] }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "hazehub-jobs-staging" }],
    "consumers": [{ "queue": "hazehub-jobs-staging", "max_batch_size": 1, "max_batch_timeout": 5, "max_retries": 3, "dead_letter_queue": "hazehub-dead-staging" }]
  },
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "STAGING_EVENT": "prototype-demo" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
