{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hazehub-gateway-staging",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "../../frontend/out", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ws"], "html_handling": "auto-trailing-slash" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
