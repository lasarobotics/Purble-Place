# HazeHub backend configuration.
# Copy to ".env" and edit, OR just set these in your shell. Everything has a
# working local default — see instructions.txt for the full Firebase setup.

# --- Datastore ---------------------------------------------------------------
# Which Firebase project holds the Firestore database. On Cloud Run this is
# discovered automatically and can be left unset.
# FIREBASE_PROJECT_ID=my-hazehub-project

# Credentials, only needed OUTSIDE Google Cloud (a laptop, a LAN server).
# Either a path to the service-account JSON, or the JSON itself.
# FIREBASE_SERVICE_ACCOUNT=C:\keys\hazehub-service-account.json

# Local development against `firebase emulators:start --only firestore`.
# When this is set no credentials are needed at all.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# With neither of the above set, HazeHub uses a JSON file in backend/data/ so
# a fresh clone runs offline. That store is for development only.

# --- Firestore quota controls ------------------------------------------------
# Snapshot listeners keep the cache live when data is changed outside this
# service, at the cost of one document read per change. Leave at 0 unless you
# run more than one instance (which also requires re-reading cache.py first).
# HAZEHUB_FIRESTORE_LISTEN=0

# Daily document-operation budgets. Below the free tier (50k/20k/20k) on
# purpose, so optional writes are shed before the real limit is reached.
# HAZEHUB_READ_BUDGET=45000
# HAZEHUB_WRITE_BUDGET=18000
# HAZEHUB_DELETE_BUDGET=18000

# How often a scouter's "last seen" timestamp is persisted (seconds). It is
# always live in memory; this only controls durability across restarts.
# HAZEHUB_PRESENCE_PERSIST=3600

# --- App ---------------------------------------------------------------------
# Shared team password used on the sign-in page (same for everyone).
HAZEHUB_TEAM_PASSWORD=HazeRain!

# Auth signing secret — CHANGE THIS in production.
HAZEHUB_SECRET=purple-haze-dev-secret-change-me

# The Blue Alliance + season.
TBA_AUTH_KEY=replace-with-your-tba-key
MATCH13_API_KEY=replace-with-your-match13-key
HAZEHUB_SEASON=2026

# Haze Intel AI summaries: works offline with the built-in rules engine.
# Set a key to upgrade the narrative to Claude (optional).
# ANTHROPIC_API_KEY=sk-ant-...
# HAZEHUB_AI_MODEL=claude-opus-4-8

# Extra CORS origins for your deployed front-end (comma separated). Not needed
# when the frontend is served by Firebase Hosting on the same origin.
# HAZEHUB_CORS=https://my-hazehub-project.web.app

# Optional UniFi/gateway stats endpoint for the admin network panel.
# HAZEHUB_GATEWAY_STATS_URL=http://192.168.1.1/api/stats
