# HazeHub backend configuration.
# Copy to ".env" and edit, OR just set these in your shell. Everything has a
# working local default — you only NEED these when deploying to Azure.

# --- Local default: leave DATABASE_URL unset to use a local SQLite file. ---
# DATABASE_URL=postgresql+psycopg://user:pass@my-server.postgres.database.azure.com:5432/hazehub

# Shared team password used on the sign-in page (same for everyone).
HAZEHUB_TEAM_PASSWORD=HazeRain!

# Auth signing secret — CHANGE THIS in production.
HAZEHUB_SECRET=purple-haze-dev-secret-change-me

# The Blue Alliance + season.
TBA_AUTH_KEY=rZxJQVjP40eTtskoUbT3OWTKEnKNxk8McjB9QqRdU8mT78o8EN3OuzuMppJTADtV
HAZEHUB_SEASON=2026

# Extra CORS origins for your deployed front-end (comma separated).
# HAZEHUB_CORS=https://hazehub.azurestaticapps.net

# Force "Azure mode" locally for testing (normally auto-detected).
# HAZEHUB_FORCE_AZURE=1
