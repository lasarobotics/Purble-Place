# HazeHub backend configuration.
# Copy to ".env" and edit, OR just set these in your shell / Vercel project
# settings. Everything has a working local default.

# --- MongoDB (local default matches backend/docker-compose.yml) -------------
MONGODB_URI=mongodb://hazehub:hazehub_dev_password@localhost:27017/?authSource=admin
MONGODB_DATABASE=hazehub
MONGODB_TIMEOUT_MS=5000
# On Vercel: set MONGODB_URI to your MongoDB Atlas connection string
# (mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority).

# Shared team password used on the sign-in page (same for everyone).
HAZEHUB_TEAM_PASSWORD=HazeRain!

# Auth signing secret — CHANGE THIS in production.
HAZEHUB_SECRET=purple-haze-dev-secret-change-me

# The Blue Alliance + season.
TBA_AUTH_KEY=rZxJQVjP40eTtskoUbT3OWTKEnKNxk8McjB9QqRdU8mT78o8EN3OuzuMppJTADtV
HAZEHUB_SEASON=2026

# Haze Intel AI summaries: works offline with the built-in rules engine.
# Set a key to upgrade the narrative to Claude (optional; requires the
# `anthropic` package to be installed).
# ANTHROPIC_API_KEY=sk-ant-...
# HAZEHUB_AI_MODEL=claude-opus-4-8

# Extra CORS origins when the frontend is served from another origin
# (comma separated). Not needed for the same-origin Vercel deployment.
# HAZEHUB_CORS=https://example.com
